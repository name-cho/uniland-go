let l = [3, 1, 2]
push(l, 4)
print(l, length(l), pop(l), l)
print(sort([3, 1, 2]), sort(["b", "a"]), reverse([1, 2, 3]))
print(slice([1, 2, 3, 4, 5], 1, 3), splice([1, 2, 3, 4], 1, 2))
print(sum([1, 2, 3]), range(1, 4), range(0, 10, 2))
print(join(map([1, 2, 3], x => x * 2), ","))
print(filter([1, 2, 3, 4], x => x % 2 == 0))
print(reduce([1, 2, 3], (acc, v) => acc + v, 10))
let seen = ""
each(["a", "b", "в"], v => { seen = seen + v })
print(seen)
let g = [[1, 2], [3, 4]]
g[1][0] = 9
print(g)
print(uppercase("тест"), lowercase("ТЕСТ"), substring("abcdef", 1, 4))
print(split("a,b,,c", ","), join(["x", "y"], "-"))
print(replace("banana", "a", "o"), trim("  x  "))
print(includes("hello", "ell"), indexOf("hello", "l"))
print(repeat("ab", 3), char_code("A"), from_char_code(104))
let m = {"ключ": "знач"}
print(m["ключ"], length(m))
