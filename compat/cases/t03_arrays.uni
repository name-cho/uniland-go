let a = [3, 1, 2]
push(a, 4)
print(a)
print(pop(a), a)
print(shift([9, 8, 7]), unshift([8, 7], 9))
print(slice([1, 2, 3, 4, 5], 1, 3))
print(splice([1, 2, 3, 4], 1, 2))
print(reverse([1, 2, 3]), sort([3, 1, 2]), sort(["b", "a"]))
print(includes([1, 2], 2), indexOf([1, 2, 2], 2))
print(sum([1, 2, 3]), range(1, 4), range(0, 10, 2))
print(join(map([1, 2, 3], x => x * 2), ","))
print(filter([1, 2, 3, 4], x => x % 2 == 0))
print(reduce([1, 2, 3], (acc, v) => acc + v, 10))
print(find([1, 2, 3], x => x > 1))
let seen = ""
each(["a", "b"], v => { seen = seen + v })
print(seen)
let g = [[1, 2], [3, 4]]
g[1][0] = 9
print(g)
print(length([1, 2, 3]))
