let fruits = ["яблоко", "груша", "слива"]
print(fruits, length(fruits), fruits[0], fruits[-1])

push(fruits, "вишня")
print(fruits, pop(fruits))
print(slice(fruits, 1, 3))

let person = {name: "Игорь", city: "Самара", age: 35}
print(person.name, person["city"])
person.age = 36
person["job"] = "инженер"
print(person)

let orders = [
    {id: 1, sum: 500, paid: true},
    {id: 2, sum: 1200, paid: false},
    {id: 3, sum: 300, paid: true}
]

let total = 0
for (o in orders) {
    total = total + o.sum
}
print("всего:", total)

let unpaid = filter(orders, o => !o.paid)
print("неоплачено:", length(unpaid), unpaid[0].id)

orders[0].sum = 550
print("после правки:", orders[0].sum)

let matrix = [[1, 2], [3, 4]]
matrix[1][0] = 30
print(matrix, matrix[1][0])

let text = join(map(fruits, f => uppercase(f)), ", ")
print(text)

print(sort([3, 1, 2]), reverse([1, 2, 3]), sum([10, 20, 30]))
print(includes(fruits, "груша"), indexOf(fruits, "слива"))
